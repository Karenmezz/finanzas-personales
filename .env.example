# Copia este archivo como .env.local y reemplaza los valores con los de Turso.
TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-privado

# Activa el acceso remoto solamente después de proteger la aplicación.
FINANCE_SYNC_ENABLED=false

# Único administrador global
ADMIN_USERNAME=admin
ADMIN_PASSWORD=usa-una-contrasena-larga-y-unica
SESSION_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
